# ---- Classifier service ----
# anthropic | openai | fake   (fake = offline keyword rules, no API key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high. Classification is a simple task; low keeps latency and cost down.
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Below this self-reported confidence, emails go to human review. Tune with evals/run_eval.py.
CONFIDENCE_THRESHOLD=0.75
MAX_BODY_CHARS=12000
# Shared secret between n8n and the classifier (generate: openssl rand -hex 32)
CLASSIFIER_API_KEY=

# ---- n8n ----
# Encrypts credentials stored in n8n. Generate once and keep it: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Callers of the triage webhook must send it in the X-Webhook-Secret header.
WEBHOOK_SECRET=
# Slack incoming-webhook URL (https://api.slack.com/messaging/webhooks). Optional.
SLACK_WEBHOOK_URL=
# Google Sheet with tabs: Tickets, Billing, Leads, Feedback, Review, DeadLetter
GOOGLE_SHEET_ID=
# OAuth client for the Google Sheets credential (Google Cloud console > Credentials).
# Redirect URI: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
N8N_PUBLIC_URL=http://localhost:5678/
TIMEZONE=UTC
