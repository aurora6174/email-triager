    {
      "id": "b756dcb0-3600-525d-bacb-285c0f1a07e2",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Accepts either the webhook payload or a Gmail Trigger item and emits one canonical\n// email object. The message_id is the idempotency key for the whole pipeline.\nconst src = $input.first().json;\nconst isWebhook = src.body !== undefined && src.headers !== undefined;\nconst p = isWebhook ? src.body : src;\n\nconst email = {\n  message_id: String(p.message_id ?? p.id ?? '').trim(),\n  sender: String(p.sender ?? p.from?.text ?? p.from ?? '').trim(),\n  subject: String(p.subject ?? '').trim(),\n  body: String(p.body ?? p.text ?? p.textPlain ?? p.snippet ?? ''),\n  received_at: p.received_at ?? p.date ?? new Date().toISOString(),\n};\n\nif (!email.message_id) throw new Error('Rejected: payload has no message_id');\nif (!email.sender) throw new Error('Rejected: payload has no sender');\nreturn [{ json: email }];"
      }
    },
    {
      "id": "e1e5b788-f429-5a32-9f7e-63865921a5e5",
      "name": "Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLASSIFIER_URL }}/v1/classify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.CLASSIFIER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 90000
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "id": "2342aa20-6cb6-53c8-9764-61bcac17bdcc",
      "name": "Skip if already routed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// The classifier remembers every message. Stop if it was already delivered (\"routed\") or\n// another run is delivering it right now (\"delivering\"), so nothing is posted twice.\n// \"classified\" on a duplicate means an earlier run failed before delivery: carry on.\nconst r = $input.first().json;\nif (r.duplicate && (r.status === 'routed' || r.status === 'delivering')) return [];\nreturn [{ json: r }];"
      }
    },
    {
      "id": "3a8b9d4c-b292-5153-b160-70f43a18999e",
      "name": "Flatten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "// One flat row per message, used by every Google Sheets destination.\nconst r = $input.first().json;\nconst email = $('Normalize').first().json;\nconst c = r.classification;\nreturn [{ json: {\n  received_at: email.received_at,\n  message_id: r.message_id,\n  sender: email.sender,\n  subject: email.subject,\n  category: c.category,\n  priority: c.priority,\n  confidence: c.confidence,\n  summary: c.summary,\n  rationale: c.rationale,\n  route: r.route,\n  review_reasons: (r.review_reasons || []).join(', '),\n  model: `${r.provider}/${r.model}`,\n  prompt_version: r.prompt_version,\n}}];"
      }
    },
